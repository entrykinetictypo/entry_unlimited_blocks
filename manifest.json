{
  "manifest_version": 3,
  "name": "콘솔을 편하게",
  "version": "1.4.1",
  "description": "엔트리의 블록 연결 제한을 해제합니다.그리고 블록의 아이디로 블록을 가져옵니다.조만간 다양한 콘솔로 할 수 있는 코드가 추가될 예정입니다.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "patch.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
