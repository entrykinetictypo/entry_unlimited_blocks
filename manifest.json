{
  "manifest_version": 3,
  "name": "콘솔을 편하게",
  "version": "1.7.3",
  "description": "엔트리의 블록 연결 제한을 해제하고, 블록 ID 및 비공식 블록을 편리하게 불러옵니다.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "patch.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
       }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "unofficial/*.js"
      ],
      "matches": [
        "https://playentry.org/*"
      ]
    }
  ]
}
